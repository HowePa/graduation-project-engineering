{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "snapshot": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "current_stage": {
      "type": "string",
      "minLength": 1
    },
    "completed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "present",
          "missing"
        ]
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "complete",
              "failed",
              "blocked"
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "updated_at",
          "detail"
        ]
      }
    },
    "gates": {
      "type": "object",
      "patternProperties": {
        "^[1-6]$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "snapshot": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "confirmed_by": {
              "type": "string",
              "minLength": 1
            },
            "confirmed_at": {
              "type": "string",
              "format": "date-time"
            },
            "note": {
              "type": "string",
              "minLength": 1
            },
            "artifacts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ]
              }
            }
          },
          "required": [
            "snapshot",
            "confirmed_by",
            "confirmed_at",
            "note",
            "artifacts"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "snapshot",
    "stages",
    "gates"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
