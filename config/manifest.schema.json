{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "snapshot": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "observed",
              "planned",
              "missing",
              "failed",
              "not_run"
            ]
          }
        },
        "required": [
          "kind",
          "path",
          "sha256",
          "status"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "snapshot",
    "entries"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
